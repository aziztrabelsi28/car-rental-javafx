<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.text.Text?>

<GridPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="ui.LoginController"
          hgap="10" vgap="10" alignment="CENTER">

    <Text text="Username:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
    <TextField fx:id="txtUsername" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

    <Text text="Password:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
    <PasswordField fx:id="txtPassword" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

    <Button text="Login" fx:id="btnLogin" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    <Button text="Create" fx:id="btnCreate" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
</GridPane>


<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.text.Text?>

<GridPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="ui.RegisterController"
          hgap="10" vgap="10" alignment="CENTER">

    <Text text="Create Account" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

    <Text text="Username:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
    <TextField fx:id="txtUsername" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

    <Text text="Password:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
    <PasswordField fx:id="txtPassword" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

    <Text text="Nom:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
    <TextField fx:id="txtNom" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
   
    <Text text="Prenom:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
    <TextField fx:id="txtPrenom" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
   
    <Button text="Register" fx:id="btnRegister" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
    <Button text="Back" fx:id="btnBack" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
</GridPane>


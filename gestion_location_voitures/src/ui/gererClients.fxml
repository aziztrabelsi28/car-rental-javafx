<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ui.ManageClientsController"
      spacing="10" alignment="CENTER" padding="20">

    <Label text="gerer Clients" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <TableView fx:id="tblClients" prefWidth="400" prefHeight="250">
        <columns>
            <TableColumn text="ID" fx:id="colId"/>
            <TableColumn text="Nom" fx:id="colNom"/>
            <TableColumn text="Prenom" fx:id="colPrenom"/>
        </columns>
    </TableView>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Ajouter Client" fx:id="btnAdd"/>
        <Button text="supprimer Client" fx:id="btnDelete"/>
        <Button text="Back" fx:id="btnBack"/>
    </HBox>
</VBox>
